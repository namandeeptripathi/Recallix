PROJECT_NAME="Recallix"
VERSION="0.1.0"
SQLITE_DB_PATH="recallix.db"

# Ollama settings — run `ollama serve` and `ollama pull gemma3:1b` first
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:1b"
# Seconds to wait for a model response (increase for larger models or slow hardware)
OLLAMA_TIMEOUT_SECONDS="120"
